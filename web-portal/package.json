{
  "name": "web-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4501 --strictPort",
    "build": "npm run build:validate-env && tsc -b && vite build",
    "build:validate-env": "bash scripts/validate-firebase-env.sh .env.production",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 4501 --strictPort",
    "auth:emulator:test": "npx -y firebase-tools --config ../firebase.json emulators:exec --project roadguard-demo --only auth,firestore \"node scripts/auth-emulator-login-check.mjs && node scripts/rbac-rules-check.mjs\"",
    "auth:emulator:test:repeat": "npm run auth:emulator:test && npm run auth:emulator:test"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
