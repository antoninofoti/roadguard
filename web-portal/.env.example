# RoadGuard final rollout uses Auth Emulator as the single auth strategy.
VITE_AUTH_MODE=emulator

# Firebase app identity (demo-safe values for emulator workflow)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=roadguard-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roadguard-demo
VITE_FIREBASE_STORAGE_BUCKET=roadguard-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Emulator endpoints
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_EMULATOR_OPERATOR_EMAILS=operator@roadguard.it
