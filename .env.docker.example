# RoadGuard — Environment configuration template
# Copy this file to .env.docker and fill in your real Firebase credentials.
#
# MODE SELECTION:
#   VITE_AUTH_MODE=production  → connects to real Firebase cloud (recommended for real data sync)
#   VITE_AUTH_MODE=emulator    → connects to local Firebase emulators (for offline development)

# ── REQUIRED: Your Firebase project credentials ─────────────────────────────
# Find these in: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# ── MODE (change to "emulator" for local development) ────────────────────────
VITE_AUTH_MODE=production

# ── EMULATOR SETTINGS (only used when VITE_AUTH_MODE=emulator) ───────────────
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_EMULATOR_OPERATOR_EMAILS=operator@roadguard.local
