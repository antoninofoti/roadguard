<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.
  Permits cleartext HTTP to Firebase emulator hosts:
    - 10.0.2.2  (Android Emulator loopback to host)
    - 127.0.0.1 (physical device with ADB port forwarding)
  This file overrides the main/res/xml/network_security_config.xml for debug builds ONLY.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Trust user-installed CAs in debug (e.g. Charles Proxy) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Firebase emulator: Android Emulator loopback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Firebase emulator: physical device with ADB reverse port forwarding -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
